# Copy this file to .env and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried in order when the main model is overloaded or
# out of quota (HTTP 503/429). Free tier quotas are per model, per day.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
PORT=3001
