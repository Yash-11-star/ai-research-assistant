{
  "name": "ai-research-assistant-server",
  "version": "1.0.0",
  "description": "Express API for the AI Research Assistant: arXiv search, local SQLite library, PDF upload/extraction, Gemini summaries and Q&A",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.11.2",
    "multer": "^2.4.0",
    "unpdf": "^1.8.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true,
  "devDependencies": {
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
